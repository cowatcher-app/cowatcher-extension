{
  "type": "module",
  "name": "cowatcher",
  "displayName": "CoWatcher",
  "version": "1.0.4",
  "description": "Smart Watch History, AI Dual Subtitles, Real-Time Translation, Language Immersion & More, your streaming companion",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "webpack --env browser=chrome",
    "build:chrome": "webpack --env browser=chrome",
    "build:firefox": "webpack --env browser=firefox",
    "build:all": "webpack --env browser=chrome && webpack --env browser=firefox",
    "watch": "webpack --watch --env browser=chrome",
    "watch:firefox": "webpack --watch --env browser=firefox",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "bash scripts/deploy-docs.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowatcher-app/cowatcher-extension.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cowatcher-app/cowatcher-extension/issues"
  },
  "homepage": "https://cowactcher-app.github.com/cowatcher-extension/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "koroman": "^1.0.16",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "path-browserify": "^1.0.1",
    "pinyin-pro": "^3.29.5",
    "pinyin-zhuyin": "^1.0.4",
    "romaja": "^0.9.0",
    "wink-lemmatizer": "^3.0.4"
  }
}
