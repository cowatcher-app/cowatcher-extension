{
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "ES2022.Error",
      "DOM"
    ],
    "types": [
      "chrome",
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@background/*": [
        "src/background/*"
      ],
      "@content/*": [
        "src/content/*"
      ],
      "@popup/*": [
        "src/popup/*"
      ],
      "@options/*": [
        "src/options/*"
      ],
      "@injected/*": [
        "src/injected/*"
      ],
      "@unlock/*": [
        "src/unlock/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
